@namespace MudBlazor.ThemeManager
@using MudBlazor.ThemeManager.Components
@using MudBlazor.ThemeManager.Models
@inherits ComponentBaseWithState

<CascadingValue Value="this">
    <MudDrawer @bind-Open:get="_openState.Value" @bind-Open:set="_openState.SetValueAsync" Anchor="Anchor.End" Elevation="25" Variant="@DrawerVariant.Temporary" Overlay="false" Width="312px">

        <MudThemePresetSelect Title="Theme Presets" Label="Active Preset" ThemePresetInfos="ThemePresetInfos" ThemePresetChanged="@(async p => await OnPresetChanged(p))" ThemePreset="ThemePreset" />
        <div class="pt-2 px-4">
            <MudText Typo="Typo.h6">Palette</MudText>
            <MudItem Class="d-flex align-center flex-grow-1 justify-space-evenly">
                <MudText Typo="Typo.caption">Light</MudText>
                <MudSwitch T="bool" Value="_isDarkModeState.Value" ValueChanged="OnIsDarkModeToggled"></MudSwitch>
                <MudText Typo="Typo.caption">Dark</MudText>
            </MudItem>
        </div>
        <MudDivider Class="my-2" />
        <div class="pt-2 px-4">
            <MudText Typo="Typo.h6" Class="mb-4">Custom Settings</MudText>
            <MudSelect Label="Drawer ClipMode" T="DrawerClipMode" Value="@ThemePreset.DrawerClipMode" ValueChanged="OnDrawerClipModeAsync" Dense="true" Underline="false" Class="my-2">
                <MudSelectItem T="DrawerClipMode" Value="DrawerClipMode.Never">Never</MudSelectItem>
                <MudSelectItem T="DrawerClipMode" Value="DrawerClipMode.Docked">Docked</MudSelectItem>
                <MudSelectItem T="DrawerClipMode" Value="DrawerClipMode.Always">Always</MudSelectItem>
            </MudSelect>
            <MudSelect Label="Font Family" T="string" Value="@ThemePreset.FontFamily" ValueChanged="OnFontFamilyAsync" Dense="true" Underline="false" Class="my-2">
                <MudSelectItem T="string" Value="@("Roboto")" />
                <MudSelectItem T="string" Value="@("Montserrat")" />
                <MudSelectItem T="string" Value="@("Segoe UI")" />
                <MudSelectItem T="string" Value="@("Ubuntu")" />
            </MudSelect>
            <MudSlider Step="1" Min="0" Max="25" T="int" Value="@ThemePreset.DefaultBorderRadius" ValueChanged="OnDefaultBorderRadiusAsync" Class="mt-3"><MudText Typo="Typo.body2">Border Radius: <b>@($"{ThemePreset.DefaultBorderRadius}px")</b></MudText></MudSlider>
            <MudSlider Step="1" Min="0" Max="25" T="int" Value="@ThemePreset.AppBarElevation" ValueChanged="OnAppBarElevationAsync"><MudText Typo="Typo.body2">AppBar Elevation: <b>@($"{ThemePreset.AppBarElevation}")</b></MudText></MudSlider>
            <MudSlider Step="1" Min="0" Max="25" T="int" Value="@ThemePreset.AppBarElevation" ValueChanged="OnDrawerElevationAsync"><MudText Typo="Typo.body2">Drawer Elevation: <b>@($"{ThemePreset.AppBarElevation}")</b></MudText></MudSlider>
            <MudSlider Step="1" Min="0" Max="25" T="int" Value="@ThemePreset.DefaultElevation" ValueChanged="OnDefaultElevationAsync"><MudText Typo="Typo.body2">Default Elevation: <b>@($"{ThemePreset.DefaultElevation}")</b></MudText></MudSlider>
        </div>
        <div class="pt-6">
            <MudText Typo="Typo.body2" GutterBottom="true" Class="mx-4 mb-4"><b>Theme Colors</b></MudText>
            <MudThemeManagerColorItem Name="Primary" ThemeColor="_currentPalette.Primary" ColorType="ThemePaletteColor.Primary" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Secondary" ThemeColor="_currentPalette.Secondary" ColorType="ThemePaletteColor.Secondary" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Tertiary" ThemeColor="_currentPalette.Tertiary" ColorType="ThemePaletteColor.Tertiary" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Info" ThemeColor="_currentPalette.Info" ColorType="ThemePaletteColor.Info" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Success" ThemeColor="_currentPalette.Success" ColorType="ThemePaletteColor.Success" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Warning" ThemeColor="_currentPalette.Warning" ColorType="ThemePaletteColor.Warning" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Error" ThemeColor="_currentPalette.Error" ColorType="ThemePaletteColor.Error" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Dark" ThemeColor="_currentPalette.Dark" ColorType="ThemePaletteColor.Dark" ColorPickerView="ColorPickerView.Spectrum" />

            <MudText Typo="Typo.body2" GutterBottom="true" Class="pt-4 mx-4"><b>Components</b></MudText>
            <MudThemeManagerColorItem Name="Appbar Text" ThemeColor="_currentPalette.AppbarText" ColorType="ThemePaletteColor.AppbarText" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Appbar BG" ThemeColor="_currentPalette.AppbarBackground" ColorType="ThemePaletteColor.AppbarBackground" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Drawer Text" ThemeColor="_currentPalette.DrawerText" ColorType="ThemePaletteColor.DrawerText" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Drawer Icons" ThemeColor="_currentPalette.DrawerIcon" ColorType="ThemePaletteColor.DrawerIcon" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Drawer BG" ThemeColor="_currentPalette.DrawerBackground" ColorType="ThemePaletteColor.DrawerBackground" ColorPickerView="ColorPickerView.Spectrum" />

            <MudText Typo="Typo.body2" GutterBottom="true" Class="pt-4 mx-4"><b>General</b></MudText>
            <MudThemeManagerColorItem Name="Surface" ThemeColor="_currentPalette.Surface" ColorType="ThemePaletteColor.Surface" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Background" ThemeColor="_currentPalette.Background" ColorType="ThemePaletteColor.Background" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Background Gray" ThemeColor="_currentPalette.BackgroundGray" ColorType="ThemePaletteColor.BackgroundGray" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Lines Default" ThemeColor="_currentPalette.LinesDefault" ColorType="ThemePaletteColor.LinesDefault" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Lines Inputs" ThemeColor="_currentPalette.LinesInputs" ColorType="ThemePaletteColor.LinesInputs" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Divider" ThemeColor="_currentPalette.Divider" ColorType="ThemePaletteColor.Divider" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Divider Light" ThemeColor="_currentPalette.DividerLight" ColorType="ThemePaletteColor.DividerLight" ColorPickerView="ColorPickerView.Spectrum" />


            <MudText Typo="Typo.body2" GutterBottom="true" Class="pt-4 mx-4"><b>Text & Actions</b></MudText>
            <MudThemeManagerColorItem Name="Text Primary" ThemeColor="_currentPalette.TextPrimary" ColorType="ThemePaletteColor.TextPrimary" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Text Secondary" ThemeColor="_currentPalette.TextSecondary" ColorType="ThemePaletteColor.TextSecondary" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Text Disabled" ThemeColor="_currentPalette.TextDisabled" ColorType="ThemePaletteColor.TextDisabled" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Action Default" ThemeColor="_currentPalette.Surface" ColorType="ThemePaletteColor.ActionDefault" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Action Disabled" ThemeColor="_currentPalette.ActionDisabled" ColorType="ThemePaletteColor.ActionDisabled" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Disabled BG" ThemeColor="_currentPalette.ActionDisabledBackground" ColorType="ThemePaletteColor.ActionDisabledBackground" ColorPickerView="ColorPickerView.Spectrum" />
            <MudThemeManagerColorItem Name="Surface" ThemeColor="_currentPalette.Surface" ColorType="ThemePaletteColor.Surface" ColorPickerView="ColorPickerView.Spectrum" />
        </div>
    </MudDrawer>
    <MudOverlay @bind-Visible:get="_openState.Value" @bind-Visible:set="_openState.SetValueAsync" OnClick="@UpdateOpenValueAsync" DarkBackground="false" />
</CascadingValue>